# OpenZyme pytest override configuration.
# Copy to `.env.test` when you want pytest-specific values.
# pytest loads `.env` first, then `.env.test`, and `.env.test` can override `.env`.

# Test-time LLM overrides
OPENZYME_LLM_API_KEY=
OPENZYME_LLM_MODEL=glm-5.1
OPENZYME_LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
OPENZYME_LLM_TIMEOUT=30
OPENZYME_LLM_MAX_RETRIES=1
OPENZYME_LLM_TEMPERATURE=0

# Keep tests bounded and deterministic
OPENZYME_RESEARCH_MAX_UNITS=2
OPENZYME_TAVILY_MAX_RESULTS=2
OPENZYME_TAVILY_TOPIC=general

# Usually disable external tracing in local tests
OPENZYME_LANGSMITH_TRACING=false
OPENZYME_LANGSMITH_PROJECT=openzyme-v2-test

# Optional client-side overrides for CLI/integration tests
OPENZYME_HOST_BASE_URL=http://127.0.0.1:8000
OPENZYME_OUTPUT_FORMAT=text
