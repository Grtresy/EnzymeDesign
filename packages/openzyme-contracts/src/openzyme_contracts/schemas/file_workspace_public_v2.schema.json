{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openzyme.dev/file_workspace_public_v2.schema.json",
  "title": "OpenZyme file_workspace_public@2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "core", "extensions"],
  "properties": {
    "schema_version": {"const": "file_workspace_public@2"},
    "release": {"$ref": "#/$defs/layered_release"},
    "core": {"$ref": "#/$defs/core"},
    "extensions": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/extension_section"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "layered_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kernel_contract_digest",
        "core_schema_digest",
        "adapter_bundle_digest",
        "extension_bundle_digest",
        "declared_tool_catalog_digest",
        "route_catalog_digest",
        "projection_catalog_digest",
        "migration_catalog_digest",
        "workspace_backend_digest",
        "host_build_digest",
        "client_build_digest",
        "release_digest",
        "public_contract_digest"
      ],
      "properties": {
        "schema_version": {"const": "openzyme_layered_release_identity@1"},
        "kernel_contract_digest": {"$ref": "#/$defs/digest"},
        "core_schema_digest": {"$ref": "#/$defs/digest"},
        "adapter_bundle_digest": {"$ref": "#/$defs/digest"},
        "extension_bundle_digest": {"$ref": "#/$defs/digest"},
        "declared_tool_catalog_digest": {"$ref": "#/$defs/digest"},
        "route_catalog_digest": {"$ref": "#/$defs/digest"},
        "projection_catalog_digest": {"$ref": "#/$defs/digest"},
        "migration_catalog_digest": {"$ref": "#/$defs/digest"},
        "workspace_backend_digest": {"$ref": "#/$defs/digest"},
        "host_build_digest": {"$ref": "#/$defs/digest"},
        "client_build_digest": {"$ref": "#/$defs/digest"},
        "release_digest": {"$ref": "#/$defs/digest"},
        "public_contract_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "tasks",
        "lanes",
        "agents",
        "protocol",
        "conversation",
        "approvals",
        "authority_leases",
        "capability_binding",
        "runtime",
        "workspace",
        "publications",
        "operations",
        "failures",
        "tool_reflection"
      ],
      "properties": {
        "session": {
          "type": "object",
          "properties": {
            "resident_readiness": {"$ref": "#/$defs/resident_readiness"}
          }
        },
        "tasks": {"type": "array"},
        "lanes": {"type": "array"},
        "agents": {"type": "array"},
        "protocol": {"type": "object"},
        "conversation": {
          "type": "object",
          "properties": {
            "transcript": {"$ref": "#/$defs/ordered_transcript"}
          }
        },
        "approvals": {"type": "array"},
        "authority_leases": {"type": "array"},
        "capability_binding": {
          "type": "object",
          "required": ["binding_digest"],
          "properties": {"binding_digest": {"$ref": "#/$defs/digest"}}
        },
        "runtime": {
          "type": "object",
          "properties": {
            "workflow_authority": {"$ref": "#/$defs/workflow_authority_projection"},
            "commands": {
              "type": "array",
              "items": {"$ref": "#/$defs/runtime_command"}
            },
            "turn_commands": {
              "type": "array",
              "items": {"$ref": "#/$defs/runtime_turn_command"}
            },
            "outcome_consumptions": {
              "type": "array",
              "items": {"$ref": "#/$defs/runtime_outcome_consumption"}
            },
            "outcomes": {
              "type": "array",
              "items": {"$ref": "#/$defs/runtime_turn_outcome_receipt"}
            }
          }
        },
        "workspace": {
          "type": "object",
          "properties": {
            "provisioning": {"$ref": "#/$defs/workspace_provisioning"}
          }
        },
        "publications": {"type": "array"},
        "operations": {"type": "object"},
        "failures": {"$ref": "#/$defs/failure_observations"},
        "tool_reflection": {"$ref": "#/$defs/tool_reflection"}
      }
    },
    "tool_reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_tool_catalog_digest",
        "affordance_snapshot_digest",
        "capability_binding_digest",
        "available_tool_names",
        "affordances"
      ],
      "properties": {
        "declared_tool_catalog_digest": {"$ref": "#/$defs/digest"},
        "affordance_snapshot_digest": {"$ref": "#/$defs/digest"},
        "capability_binding_digest": {"$ref": "#/$defs/digest"},
        "available_tool_names": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "affordances": {
          "type": "array",
          "items": {"$ref": "#/$defs/tool_affordance"}
        },
        "tool_exposure": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/tool_exposure"}
          ]
        }
      }
    },
    "tool_affordance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "tool_contract_digest",
        "state",
        "required_authorities",
        "route_ids",
        "route_refs",
        "blockers"
      ],
      "properties": {
        "tool_name": {"type": "string", "minLength": 1},
        "tool_contract_digest": {"$ref": "#/$defs/digest"},
        "state": {
          "enum": [
            "available",
            "available_with_approval",
            "blocked_dependency",
            "blocked_configuration",
            "blocked_qualification",
            "blocked_authority",
            "blocked_provisioning",
            "temporarily_unavailable"
          ]
        },
        "required_authorities": {"type": "array", "items": {"type": "string"}},
        "route_ids": {"type": "array", "items": {"type": "string"}},
        "route_refs": {"type": "array", "items": {"type": "object"}},
        "blockers": {"type": "array", "items": {"type": "object"}}
      }
    },
    "resident_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "readiness", "workspace_id", "workspace_generation",
        "provisioning_intent_id", "provisioning_intent_digest", "failure_id",
        "next_action"
      ],
      "properties": {
        "schema_version": {"const": "resident_teammate_readiness@1"},
        "readiness": {"enum": ["provisioning", "ready", "blocked"]},
        "workspace_id": {"type": "string", "minLength": 1},
        "workspace_generation": {"type": "integer", "minimum": 1},
        "provisioning_intent_id": {"type": "string", "minLength": 1},
        "provisioning_intent_digest": {"$ref": "#/$defs/digest"},
        "failure_id": {"type": ["string", "null"]},
        "next_action": {"type": ["string", "null"], "maxLength": 8192}
      }
    },
    "workspace_provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "intent_id", "intent_digest", "intent_state_version", "status", "workspace_id",
        "workspace_generation", "runtime_binding_id", "failure_id", "error_code",
        "effect_certainty", "mutation_applied", "fallback_performed",
        "retry_permitted", "reconcile_required", "diagnostic_id", "next_action",
        "reconciliation"
      ],
      "properties": {
        "schema_version": {"const": "workspace_provisioning_public@2"},
        "intent_id": {"type": "string", "minLength": 1},
        "intent_digest": {"$ref": "#/$defs/digest"},
        "intent_state_version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["pending", "claimed", "ready", "blocked", "cancelled"]},
        "workspace_id": {"type": "string", "minLength": 1},
        "workspace_generation": {"type": "integer", "minimum": 1},
        "runtime_binding_id": {"type": ["string", "null"]},
        "failure_id": {"type": ["string", "null"]},
        "error_code": {"type": ["string", "null"]},
        "effect_certainty": {
          "enum": [null, "no_effect", "dispatch_in_doubt", "effect_known", "terminal_known"]
        },
        "mutation_applied": {"type": ["boolean", "null"]},
        "fallback_performed": {"const": false},
        "retry_permitted": {"const": false},
        "reconcile_required": {"type": "boolean"},
        "diagnostic_id": {"type": ["string", "null"]},
        "next_action": {"type": ["string", "null"], "maxLength": 8192},
        "reconciliation": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/workspace_provisioning_reconciliation"}
          ]
        }
      }
    },
    "workspace_provisioning_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "reconciliation_id", "reconciliation_digest", "status",
        "attempt", "parent_reconciliation_id", "blocked_intent_state_version",
        "blocked_intent_digest", "source_receipt_id", "source_receipt_digest",
        "dispatch_receipt_digest", "result_receipt_id", "result_receipt_digest",
        "effect_certainty", "mutation_applied", "fallback_performed",
        "retry_permitted", "reconcile_required", "failure_id", "diagnostic_id",
        "requested_at", "requested_claim_seconds", "settled_at", "next_action"
      ],
      "properties": {
        "schema_version": {"const": "workspace_provisioning_reconciliation_public@1"},
        "reconciliation_id": {"type": "string", "minLength": 1},
        "reconciliation_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["pending", "claimed", "ready", "blocked"]},
        "attempt": {"type": "integer", "minimum": 1},
        "parent_reconciliation_id": {"type": ["string", "null"]},
        "blocked_intent_state_version": {"type": "integer", "minimum": 1},
        "blocked_intent_digest": {"$ref": "#/$defs/digest"},
        "source_receipt_id": {"type": "string", "minLength": 1},
        "source_receipt_digest": {"$ref": "#/$defs/digest"},
        "dispatch_receipt_digest": {"$ref": "#/$defs/digest"},
        "result_receipt_id": {"type": ["string", "null"]},
        "result_receipt_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "effect_certainty": {
          "enum": [null, "no_effect", "dispatch_in_doubt", "effect_known", "terminal_known"]
        },
        "mutation_applied": {"type": ["boolean", "null"]},
        "fallback_performed": {"const": false},
        "retry_permitted": {"const": false},
        "reconcile_required": {"type": "boolean"},
        "failure_id": {"type": ["string", "null"]},
        "diagnostic_id": {"type": ["string", "null"]},
        "requested_at": {"type": "string", "minLength": 1},
        "requested_claim_seconds": {
          "type": "integer", "minimum": 1, "maximum": 86400
        },
        "settled_at": {"type": ["string", "null"]},
        "next_action": {"type": ["string", "null"], "maxLength": 8192}
      }
    },
    "workflow_authority_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "bindings", "signal_links"],
      "properties": {
        "schema_version": {"const": "workflow_authority_projection@1"},
        "bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/workflow_authority_binding"}
        },
        "signal_links": {
          "type": "array",
          "items": {"$ref": "#/$defs/runtime_signal_authority_link"}
        }
      }
    },
    "workflow_authority_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "authority_id", "session_id", "project_id",
        "request_lineage_id", "source_message_id", "source_principal_id",
        "authorized_actor_id", "selected_workflow_refs", "selection_digest",
        "registry_snapshot_digest", "parent_authority_id", "parent_authority_digest",
        "derivation_kind", "task_id", "lane_id", "status", "epoch",
        "state_version", "created_at", "updated_at", "revoked_at", "expires_at",
        "consumed_at", "scope_digest", "binding_digest"
      ],
      "properties": {
        "schema_version": {"const": "workflow_authority_binding@1"},
        "authority_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "request_lineage_id": {"type": "string", "minLength": 1},
        "source_message_id": {"type": "string", "minLength": 1},
        "source_principal_id": {"type": "string", "minLength": 1},
        "authorized_actor_id": {"type": "string", "minLength": 1},
        "selected_workflow_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "selection_digest": {"$ref": "#/$defs/digest"},
        "registry_snapshot_digest": {"$ref": "#/$defs/digest"},
        "parent_authority_id": {"type": ["string", "null"]},
        "parent_authority_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "derivation_kind": {"enum": ["root_message", "delegation", "protocol_delivery", "approval_resolution", "continuation_delivery"]},
        "task_id": {"type": ["string", "null"]},
        "lane_id": {"type": ["string", "null"]},
        "status": {"enum": ["active", "revoked", "expired", "consumed"]},
        "epoch": {"type": "integer", "minimum": 1},
        "state_version": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1},
        "revoked_at": {"type": ["string", "null"]},
        "expires_at": {"type": ["string", "null"]},
        "consumed_at": {"type": ["string", "null"]},
        "scope_digest": {"$ref": "#/$defs/digest"},
        "binding_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "runtime_signal_authority_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "signal_id", "session_id", "authority_id",
        "authority_epoch", "authority_binding_digest", "causation_ref",
        "source_kind", "created_at", "link_digest"
      ],
      "properties": {
        "schema_version": {"const": "runtime_signal_authority_link@1"},
        "signal_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "authority_id": {"type": "string", "minLength": 1},
        "authority_epoch": {"type": "integer", "minimum": 1},
        "authority_binding_digest": {"$ref": "#/$defs/digest"},
        "causation_ref": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["root_message", "delegation", "protocol_message", "approval_resolution", "continuation", "continuation_delivery"]},
        "created_at": {"type": "string", "minLength": 1},
        "link_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "runtime_command_outcome_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "processed_signals", "turn_count", "turns_digest",
        "runtime_executed", "task_transition_performed", "fallback_performed"
      ],
      "properties": {
        "schema_version": {"const": "runtime_command_outcome_summary_public@1"},
        "processed_signals": {"type": "integer", "minimum": 0, "maximum": 1024},
        "turn_count": {"type": "integer", "minimum": 0, "maximum": 1024},
        "turns_digest": {"$ref": "#/$defs/digest"},
        "runtime_executed": {"type": "boolean"},
        "task_transition_performed": {"type": "boolean"},
        "fallback_performed": {"const": false}
      }
    },
    "runtime_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "command_id", "session_id", "command_type",
        "request_digest", "idempotency_key", "status", "max_signals",
        "max_steps_per_agent", "auto_enqueue_ready_tasks", "state_version",
        "fencing_token", "accepted_at", "claim_owner",
        "lease_expires_at", "bounded_outcome_summary", "failure_id",
        "diagnostic_id", "error_code",
        "safe_error_summary", "safe_retry_hint", "started_at", "completed_at"
      ],
      "properties": {
        "schema_version": {"const": "runtime_command_public@1"},
        "command_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "command_type": {"const": "runtime.drain"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "idempotency_key": {"type": "string", "minLength": 1},
        "status": {"enum": ["accepted", "claimed", "completed", "failed", "locked", "cancelled"]},
        "max_signals": {"type": "integer", "minimum": 1},
        "max_steps_per_agent": {"type": "integer", "minimum": 1},
        "auto_enqueue_ready_tasks": {"type": "boolean"},
        "state_version": {"type": "integer", "minimum": 1},
        "fencing_token": {"type": "integer", "minimum": 0},
        "accepted_at": {"type": "string", "minLength": 1},
        "claim_owner": {"type": ["string", "null"]},
        "lease_expires_at": {"type": ["string", "null"]},
        "bounded_outcome_summary": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/runtime_command_outcome_summary"}
          ]
        },
        "failure_id": {"type": ["string", "null"]},
        "diagnostic_id": {"type": ["string", "null"]},
        "error_code": {"type": ["string", "null"]},
        "safe_error_summary": {"type": ["string", "null"], "maxLength": 8192},
        "safe_retry_hint": {"type": ["string", "null"], "maxLength": 8192},
        "started_at": {"type": ["string", "null"]},
        "completed_at": {"type": ["string", "null"]}
      }
    },
    "runtime_outcome_consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "consumption_id", "consumption_digest",
        "command_id", "command_digest", "outcome_id", "outcome_digest",
        "outcome_receipt_id", "outcome_receipt_digest", "session_id",
        "agent_id", "agent_member_id", "signal_id", "signal_attempt",
        "continuation_intent_id", "settlement_intent_id", "consumed_at"
      ],
      "properties": {
        "schema_version": {"const": "runtime_outcome_consumption_public@1"},
        "consumption_id": {"type": "string", "minLength": 1},
        "consumption_digest": {"$ref": "#/$defs/digest"},
        "command_id": {"type": "string", "minLength": 1},
        "command_digest": {"$ref": "#/$defs/digest"},
        "outcome_id": {"type": "string", "minLength": 1},
        "outcome_digest": {"$ref": "#/$defs/digest"},
        "outcome_receipt_id": {"type": "string", "minLength": 1},
        "outcome_receipt_digest": {"$ref": "#/$defs/digest"},
        "session_id": {"type": "string", "minLength": 1},
        "agent_id": {"type": "string", "minLength": 1},
        "agent_member_id": {"type": "string", "minLength": 1},
        "signal_id": {"type": "string", "minLength": 1},
        "signal_attempt": {"type": "integer", "minimum": 1},
        "continuation_intent_id": {"type": ["string", "null"]},
        "settlement_intent_id": {"type": "string", "minLength": 1},
        "consumed_at": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "runtime_turn_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "command_id", "turn_id", "session_id", "agent_id",
        "agent_member_id", "signal_id", "signal_attempt",
        "runtime_lease_generation", "runtime_fence",
        "process_epoch", "distribution_id", "distribution_manifest_digest",
        "release_digest", "adapter_bundle_digest", "extension_bundle_digest",
        "declared_tool_catalog_digest", "capability_binding_id",
        "capability_binding_revision", "capability_binding_digest",
        "affordance_snapshot_id", "affordance_snapshot_digest",
        "workflow_authority_id", "workflow_authority_epoch",
        "workflow_authority_digest", "signal_authority_link_digest",
        "tool_exposure_snapshot_id", "tool_exposure_snapshot_digest",
        "context_digest", "message_count",
        "runtime_adapter_id", "runtime_adapter_contract_digest", "max_steps",
        "max_duration_seconds", "max_input_units", "max_output_units",
        "task_id", "lane_id", "continuation_id", "source_command_digest"
      ],
      "properties": {
        "schema_version": {"const": "runtime_turn_command_public@1"},
        "command_id": {"type": "string", "minLength": 1},
        "turn_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "agent_id": {"type": "string", "minLength": 1},
        "agent_member_id": {"type": "string", "minLength": 1},
        "signal_id": {"type": "string", "minLength": 1},
        "signal_attempt": {"type": "integer", "minimum": 1},
        "runtime_lease_generation": {"type": "integer", "minimum": 1},
        "runtime_fence": {"type": "integer", "minimum": 1},
        "process_epoch": {"type": "integer", "minimum": 1},
        "distribution_id": {"type": "string", "minLength": 1},
        "distribution_manifest_digest": {"$ref": "#/$defs/digest"},
        "release_digest": {"$ref": "#/$defs/digest"},
        "adapter_bundle_digest": {"$ref": "#/$defs/digest"},
        "extension_bundle_digest": {"$ref": "#/$defs/digest"},
        "declared_tool_catalog_digest": {"$ref": "#/$defs/digest"},
        "capability_binding_id": {"type": "string", "minLength": 1},
        "capability_binding_revision": {"type": "integer", "minimum": 1},
        "capability_binding_digest": {"$ref": "#/$defs/digest"},
        "affordance_snapshot_id": {"type": "string", "minLength": 1},
        "affordance_snapshot_digest": {"$ref": "#/$defs/digest"},
        "workflow_authority_id": {"type": "string", "minLength": 1},
        "workflow_authority_epoch": {"type": "integer", "minimum": 1},
        "workflow_authority_digest": {"$ref": "#/$defs/digest"},
        "signal_authority_link_digest": {"$ref": "#/$defs/digest"},
        "tool_exposure_snapshot_id": {"type": "string", "minLength": 1},
        "tool_exposure_snapshot_digest": {"$ref": "#/$defs/digest"},
        "context_digest": {"$ref": "#/$defs/digest"},
        "message_count": {"type": "integer", "minimum": 1, "maximum": 512},
        "runtime_adapter_id": {"type": "string", "minLength": 1},
        "runtime_adapter_contract_digest": {"$ref": "#/$defs/digest"},
        "max_steps": {"type": "integer", "minimum": 1},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_input_units": {"type": "integer", "minimum": 1},
        "max_output_units": {"type": "integer", "minimum": 1},
        "task_id": {"type": ["string", "null"]},
        "lane_id": {"type": ["string", "null"]},
        "continuation_id": {"type": ["string", "null"]},
        "source_command_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "runtime_turn_outcome_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "receipt_id", "outcome", "accepted_at", "source_receipt_digest"],
      "properties": {
        "schema_version": {"const": "runtime_turn_outcome_receipt_public@1"},
        "receipt_id": {"type": "string", "minLength": 1},
        "outcome": {"$ref": "#/$defs/runtime_turn_outcome"},
        "accepted_at": {"type": "string", "minLength": 1},
        "source_receipt_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "runtime_turn_outcome": {
      "type": "object",
