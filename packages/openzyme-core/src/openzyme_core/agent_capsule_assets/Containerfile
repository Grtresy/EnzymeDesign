ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG DEBIAN_SNAPSHOT=20250811T000000Z
ARG BASH_VERSION=5.2.15-2+b9
ARG CA_CERTIFICATES_VERSION=20230311+deb12u1
ARG COREUTILS_VERSION=9.1-1
ARG CURL_VERSION=7.88.1-10+deb12u14
ARG FINDUTILS_VERSION=4.9.0-4
ARG GAWK_VERSION=1:5.2.1-2
ARG GIT_VERSION=1:2.39.5-0+deb12u2
ARG GIT_LFS_VERSION=3.3.0-1+b5
ARG GREP_VERSION=3.8-5
ARG GZIP_VERSION=1.12-1
ARG OPENSSH_CLIENT_VERSION=1:9.2p1-2+deb12u7
ARG PYTHON3_VERSION=3.11.2-1+b1
ARG RSYNC_VERSION=3.2.7-1+deb12u2
ARG SED_VERSION=4.9-1
ARG TAR_VERSION=1.34+dfsg-1.2+deb12u1
ARG UNZIP_VERSION=6.0-28

RUN printf '%s\n' \
      "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ bookworm main" \
      "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}/ bookworm-security main" \
      > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/* \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install --yes --no-install-recommends \
      "bash=${BASH_VERSION}" \
      "ca-certificates=${CA_CERTIFICATES_VERSION}" \
      "coreutils=${COREUTILS_VERSION}" \
      "curl=${CURL_VERSION}" \
      "findutils=${FINDUTILS_VERSION}" \
      "gawk=${GAWK_VERSION}" \
      "git=${GIT_VERSION}" \
      "git-lfs=${GIT_LFS_VERSION}" \
      "grep=${GREP_VERSION}" \
      "gzip=${GZIP_VERSION}" \
      "openssh-client=${OPENSSH_CLIENT_VERSION}" \
      "python3=${PYTHON3_VERSION}" \
      "rsync=${RSYNC_VERSION}" \
      "sed=${SED_VERSION}" \
      "tar=${TAR_VERSION}" \
      "unzip=${UNZIP_VERSION}" \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 --shell /bin/bash openzyme \
 && install -d -o 10001 -g 10001 /workspace /workspace/repository

COPY --chmod=0555 qualification.sh /usr/local/libexec/openzyme-agent-capsule-qualify
COPY --chown=0:0 pipeline_sdk/openzyme_pipeline /opt/openzyme-sdk/openzyme_pipeline
RUN find /opt/openzyme-sdk -type d -exec chmod 0555 {} + \
 && find /opt/openzyme-sdk -type f -exec chmod 0444 {} +

USER 10001:10001
ENV HOME=/home/openzyme \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONPATH=/opt/openzyme-sdk \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_TERMINAL_PROMPT=0
WORKDIR /workspace/repository

CMD ["/bin/bash"]
