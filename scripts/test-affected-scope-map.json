{
    "complete_safe": {
        "frontend": true,
        "lint_paths": [
            "apps",
            "packages",
            "scripts"
        ],
        "pytest_paths": [
            "apps",
            "packages"
        ],
        "reason": "unknown or test-orchestration impact requires the complete non-live diagnostic set"
    },
    "minimum_sanity": {
        "frontend": false,
        "lint_paths": [
            "scripts/run-test-gate.py",
            "scripts/test_gate"
        ],
        "pytest_paths": [
            "packages/openzyme-core/tests/test_test_gate_contract.py",
            "packages/openzyme-core/tests/test_test_gate_diagnostic.py"
        ],
        "reason": "exact documentation/archive-only rule retains nonempty test-gate sanity checks"
    },
    "planner_id": "openzyme_test_diagnostic_planner@1",
    "required_owner_roots": [
        "apps/mcp-hpc-runner",
        "apps/openzyme-host-api",
        "apps/openzyme-host-cli",
        "apps/openzyme-web-ui",
        "packages/openzyme-core",
        "packages/openzyme-domain",
        "packages/openzyme-engines",
        "packages/openzyme-execution",
        "packages/openzyme-pipeline",
        "packages/openzyme-research",
        "packages/openzyme-runtime",
        "packages/openzyme-tools",
        "packages/preprocess-backend"
    ],
    "rules": [
        {
            "frontend": true,
            "id": "test-gate-planner-complete-safe",
            "lint_paths": [],
            "matching_tests": false,
            "mode": "complete_safe",
            "owner_test_root": null,
            "paths": [
                "scripts/run-test-gate.py",
                "scripts/test-gate.toml",
                "scripts/test-affected-scope-map.json"
            ],
            "prefixes": [
                "scripts/test_gate/"
            ],
            "pytest_paths": [],
            "reason": "planner or dependency-map changes invalidate diagnostic narrowing"
        },
        {
            "frontend": true,
            "id": "mainline-or-qualification-contract-complete-safe",
            "lint_paths": [],
            "matching_tests": false,
            "mode": "complete_safe",
            "owner_test_root": null,
            "paths": [
                "scripts/check-mainline.sh",
                "scripts/check-v3-architecture-qualification.sh",
                "pytest.ini",
                "pyproject.toml",
                "uv.lock",
                "skills-lock.json"
            ],
            "prefixes": [
                ".github/",
                "deploy/",
                "docker/"
            ],
            "pytest_paths": [],
            "reason": "workspace, lock, CI, or authority-contract changes require complete safe coverage"
        },
        {
            "frontend": false,
            "id": "compatibility-audit-contract",
            "lint_paths": [
                "scripts/audit-v3-compat-callers.py"
            ],
            "matching_tests": false,
            "mode": "mapped",
            "owner_test_root": null,
            "paths": [
                "scripts/audit-v3-compat-callers.py"
            ],
            "prefixes": [],
            "pytest_paths": [
                "packages/openzyme-core/tests/test_compat_caller_audit.py"
            ],
            "reason": "compatibility audit has an exact owner regression"
        },
        {
            "frontend": true,
            "id": "python-workspace-member-metadata-complete-safe",
            "lint_paths": [],
            "matching_tests": false,
            "mode": "complete_safe",
            "owner_test_root": null,
            "paths": [
                "apps/mcp-hpc-runner/pyproject.toml",
                "apps/openzyme-host-api/pyproject.toml",
                "apps/openzyme-host-cli/pyproject.toml",
                "packages/openzyme-core/pyproject.toml",
                "packages/openzyme-domain/pyproject.toml",
                "packages/openzyme-engines/pyproject.toml",
                "packages/openzyme-execution/pyproject.toml",
                "packages/openzyme-pipeline/pyproject.toml",
                "packages/openzyme-research/pyproject.toml",
                "packages/openzyme-runtime/pyproject.toml",
                "packages/openzyme-tools/pyproject.toml",
                "packages/preprocess-backend/pyproject.toml"
            ],
            "prefixes": [],
            "pytest_paths": [],
            "reason": "workspace member dependency metadata can change every Python consumer"
        },
        {
            "frontend": true,
            "id": "core-migration-contracts-complete-safe",
            "lint_paths": [],
            "matching_tests": false,
            "mode": "complete_safe",
            "owner_test_root": null,
            "paths": [],
            "prefixes": [
                "packages/openzyme-core/src/openzyme_core/migrations/"
            ],
            "pytest_paths": [],
            "reason": "schema migrations can change Core, Host API, projection, and Web UI contracts"
        },
        {
            "frontend": true,
            "id": "core-public-ui-contracts",
            "lint_paths": [
                "packages/openzyme-core"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "packages/openzyme-core/tests",
            "paths": [
                "packages/openzyme-core/src/openzyme_core/controlled_operation_execution.py",
                "packages/openzyme-core/src/openzyme_core/controlled_operation_projection.py",
                "packages/openzyme-core/src/openzyme_core/file_workspace_contract.py",
                "packages/openzyme-core/src/openzyme_core/file_workspace_projection.py",
                "packages/openzyme-core/src/openzyme_core/file_workspace_public_contract.py",
                "packages/openzyme-core/src/openzyme_core/lane_manager.py",
                "packages/openzyme-core/src/openzyme_core/protocols.py",
                "packages/openzyme-core/src/openzyme_core/report_drafts.py",
                "packages/openzyme-core/src/openzyme_core/report_publication.py",
                "packages/openzyme-core/src/openzyme_core/revision_path_handoffs.py",
                "packages/openzyme-core/src/openzyme_core/runtime_command_projection.py",
                "packages/openzyme-core/src/openzyme_core/runtime_commands.py",
                "packages/openzyme-core/src/openzyme_core/runtime_drain_receipts.py",
                "packages/openzyme-core/src/openzyme_core/task_board.py",
                "packages/openzyme-core/src/openzyme_core/task_evidence.py",
                "packages/openzyme-core/src/openzyme_core/trace_projection.py"
            ],
            "prefixes": [],
            "pytest_paths": [
                "apps/openzyme-host-api/tests/test_api.py",
                "packages/openzyme-core/tests/test_agent_git_workspaces.py"
            ],
            "reason": "workspace, revision, report, file, event, and evidence shapes are consumed by the Web UI"
        },
        {
            "frontend": true,
            "id": "runtime-public-diagnostic-contracts",
            "lint_paths": [
                "packages/openzyme-runtime"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "packages/openzyme-runtime/tests",
            "paths": [
                "packages/openzyme-runtime/src/openzyme_runtime/public_diagnostics.py"
            ],
            "prefixes": [],
            "pytest_paths": [
                "apps/openzyme-host-api/tests/test_api.py"
            ],
            "reason": "public diagnostic projections have UI consumers"
        },
        {
            "frontend": false,
            "id": "mcp-hpc-runner-owner",
            "lint_paths": [
                "apps/mcp-hpc-runner"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "apps/mcp-hpc-runner/tests",
            "paths": [],
            "prefixes": [
                "apps/mcp-hpc-runner/"
            ],
            "pytest_paths": [],
            "reason": "HPC runner changes select owner-local non-live contracts"
        },
        {
            "frontend": true,
            "id": "host-api-owner-and-ui-contract",
            "lint_paths": [
                "apps/openzyme-host-api"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "apps/openzyme-host-api/tests",
            "paths": [],
            "prefixes": [
                "apps/openzyme-host-api/"
            ],
            "pytest_paths": [],
            "reason": "Host API response and event shapes may be consumed by the Web UI"
        },
        {
            "frontend": false,
            "id": "host-cli-owner",
            "lint_paths": [
                "apps/openzyme-host-cli"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "apps/openzyme-host-cli/tests",
            "paths": [],
            "prefixes": [
                "apps/openzyme-host-cli/"
            ],
            "pytest_paths": [],
            "reason": "thin CLI changes select CLI owner tests"
        },
        {
            "frontend": true,
            "id": "web-ui-owner",
            "lint_paths": [],
            "matching_tests": false,
            "mode": "mapped",
            "owner_test_root": null,
            "paths": [],
            "prefixes": [
                "apps/openzyme-web-ui/"
            ],
            "pytest_paths": [],
            "reason": "Web UI source, tests, metadata, lock, or build inputs require test and production build"
        },
        {
            "frontend": false,
            "id": "openzyme-core-owner",
            "lint_paths": [
                "packages/openzyme-core"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "packages/openzyme-core/tests",
            "paths": [],
            "prefixes": [
                "packages/openzyme-core/"
            ],
            "pytest_paths": [],
            "reason": "core-local changes use exact matching owner tests when available"
        },
        {
            "frontend": true,
            "id": "openzyme-domain-cross-layer",
            "lint_paths": [
                "packages/openzyme-domain"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "packages/openzyme-domain/tests",
            "paths": [],
            "prefixes": [
                "packages/openzyme-domain/"
            ],
            "pytest_paths": [
                "apps/openzyme-host-api/tests/test_api.py",
                "packages/openzyme-core/tests/test_agent_capability_projection.py"
            ],
            "reason": "control-plane domain shapes cross Core, Host API, and Web UI boundaries"
        },
        {
            "frontend": false,
            "id": "openzyme-engines-owner",
            "lint_paths": [
                "packages/openzyme-engines"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "packages/openzyme-engines/tests",
            "paths": [],
            "prefixes": [
                "packages/openzyme-engines/"
            ],
            "pytest_paths": [],
            "reason": "capability-engine changes select owner tests"
        },
        {
            "frontend": false,
            "id": "openzyme-execution-cross-layer",
            "lint_paths": [
                "packages/openzyme-execution"
            ],
            "matching_tests": false,
            "mode": "mapped",
            "owner_test_root": null,
            "paths": [],
            "prefixes": [
                "packages/openzyme-execution/"
            ],
            "pytest_paths": [
                "apps/openzyme-host-api/tests/test_workspace_revision_execution_boundary.py"
            ],
            "reason": "workspace revision runner adapter DTOs cross the Host execution boundary"
        },
        {
            "frontend": false,
            "id": "openzyme-pipeline-owner",
            "lint_paths": [
                "packages/openzyme-pipeline"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "packages/openzyme-pipeline/tests",
            "paths": [],
            "prefixes": [
                "packages/openzyme-pipeline/"
            ],
            "pytest_paths": [],
            "reason": "sandbox SDK changes select pipeline owner tests"
        },
        {
            "frontend": false,
            "id": "openzyme-research-owner",
            "lint_paths": [
                "packages/openzyme-research"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "packages/openzyme-research/tests",
            "paths": [],
            "prefixes": [
                "packages/openzyme-research/"
            ],
            "pytest_paths": [],
            "reason": "research provider changes select non-live owner tests"
        },
        {
            "frontend": false,
            "id": "openzyme-runtime-owner",
            "lint_paths": [
                "packages/openzyme-runtime"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "packages/openzyme-runtime/tests",
            "paths": [],
            "prefixes": [
                "packages/openzyme-runtime/"
            ],
            "pytest_paths": [],
            "reason": "shared runtime changes select owner tests; public projections have a more specific UI rule"
        },
        {
            "frontend": false,
            "id": "openzyme-tools-owner",
            "lint_paths": [
                "packages/openzyme-tools"
            ],
            "matching_tests": false,
            "mode": "mapped",
            "owner_test_root": null,
            "paths": [],
            "prefixes": [
                "packages/openzyme-tools/"
            ],
            "pytest_paths": [
                "packages/openzyme-core/tests/test_skills.py"
            ],
            "reason": "the retained static HPC skill catalog is consumed by the Core skill loader"
        },
        {
            "frontend": false,
            "id": "preprocess-backend-owner",
            "lint_paths": [
                "packages/preprocess-backend"
            ],
            "matching_tests": true,
            "mode": "mapped",
            "owner_test_root": "packages/preprocess-backend/tests",
            "paths": [],
            "prefixes": [
                "packages/preprocess-backend/"
            ],
            "pytest_paths": [],
            "reason": "preprocess backend changes select owner API tests"
        },
        {
            "frontend": false,
            "id": "documentation-and-spec-minimum-sanity",
            "lint_paths": [],
            "matching_tests": false,
            "mode": "minimum_sanity",
            "owner_test_root": null,
            "paths": [
                "AGENTS.md",
                "README.md"
            ],
            "prefixes": [
                ".agents/",
                ".codex/",
                "docs/",
                "legacy/",
                "openspec/"
            ],
            "pytest_paths": [],
            "reason": "exact documentation, agent guidance, archived source, and OpenSpec inputs retain test-gate sanity"
        },
        {
            "frontend": true,
            "id": "other-repository-scripts-complete-safe",
            "lint_paths": [],
            "matching_tests": false,
            "mode": "complete_safe",
            "owner_test_root": null,
            "paths": [],
            "prefixes": [
                "scripts/"
            ],
            "pytest_paths": [],
            "reason": "unclassified repository tooling can alter validation semantics"
        }
    ],
    "schema_id": "openzyme_test_affected_scope_map@1"
}
