        "packages/openzyme-core/src/openzyme_core/report_publication.py",
        "packages/openzyme-core/src/openzyme_core/result_artifacts.py",
        "packages/openzyme-core/src/openzyme_core/runtime_command_projection.py",
        "packages/openzyme-core/src/openzyme_core/runtime_commands.py",
        "packages/openzyme-core/src/openzyme_core/runtime_drain_receipts.py",
        "packages/openzyme-core/src/openzyme_core/task_board.py",
        "packages/openzyme-core/src/openzyme_core/task_evidence.py",
        "packages/openzyme-core/src/openzyme_core/trace_projection.py"
      ],
      "prefixes": [],
      "lint_paths": [
        "packages/openzyme-core"
      ],
      "pytest_paths": [
        "apps/openzyme-host-api/tests/test_api.py",
        "packages/openzyme-core/tests/test_projections.py"
      ],
      "owner_test_root": "packages/openzyme-core/tests",
      "matching_tests": true,
      "frontend": true,
      "mode": "mapped",
      "reason": "workspace, projection, report, artifact, event, and evidence shapes are consumed by the Web UI"
    },
    {
      "id": "runtime-public-artifact-contracts",
      "paths": [
        "packages/openzyme-runtime/src/openzyme_runtime/artifact_projection.py",
        "packages/openzyme-runtime/src/openzyme_runtime/public_diagnostics.py"
