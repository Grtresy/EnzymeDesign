            "packages/openzyme-kernel/tests/test_test_gate_contract.py",
            "packages/openzyme-kernel/tests/test_test_gate_diagnostic.py"
        ],
        "reason": "exact documentation/archive-only rule retains nonempty test-gate sanity checks"
    },
