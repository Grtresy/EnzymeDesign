      "prefixes": [],
      "lint_paths": [
        "packages/openzyme-runtime"
      ],
      "pytest_paths": [
        "apps/openzyme-host-api/tests/test_api.py"
      ],
      "owner_test_root": "packages/openzyme-runtime/tests",
      "matching_tests": true,
      "frontend": true,
      "mode": "mapped",
      "reason": "public artifact and diagnostic projections have UI consumers"
    },
    {
      "id": "mcp-hpc-runner-owner",
      "paths": [],
