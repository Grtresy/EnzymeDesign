      ],
      "lint_paths": [
        "packages/openzyme-runtime"
      ],
      "pytest_paths": [],
      "owner_test_root": "packages/openzyme-runtime/tests",
      "matching_tests": true,
      "frontend": false,
      "mode": "mapped",
