      "paths": [],
      "prefixes": [
        "packages/openzyme-tools/"
      ],
      "lint_paths": [
        "packages/openzyme-tools"
      ],
      "pytest_paths": [],
      "owner_test_root": "packages/openzyme-tools/tests",
