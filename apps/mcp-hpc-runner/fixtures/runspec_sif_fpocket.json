{
  "name": "fpocket-eval",
  "stage": "evaluator",
  "execution_mode": "sbatch",
  "resources": {
    "cpus": 4,
    "mem_mb": 8192,
    "gpus": 0,
    "time_minutes": 30,
    "partition": "cpu"
  },
  "command": [
    "apptainer",
    "exec",
    "--cleanenv",
    "--bind",
    "${WORKDIR}:/work",
    "--bind",
    "${OUTDIR}:/out",
    "--bind",
    "${DBDIR}:/db",
    "--bind",
    "${MODELDIR}:/models",
    "--bind",
    "${TMPDIR}:/tmp",
    "~/containers/fpocket.sif",
    "fpocket",
    "-f",
    "/work/target.pdb"
  ],
  "inputs": [
    {
      "local_path": "examples/target.pdb",
      "remote_path": "target.pdb",
      "required": true
    }
  ],
  "expected_outputs": [
    {
      "path": "target_out",
      "kind": "dir",
      "required": true,
      "non_empty": true
    }
  ],
  "success_checks": [
    {
      "check_type": "exists",
      "path": "target_out"
    },
    {
      "check_type": "non_empty",
      "path": "target_out"
    }
  ],
  "failure_signatures": [
    {
      "pattern": "bind path.*not visible",
      "error_code": "SIF_BIND_PATH_ERROR"
    },
    {
      "pattern": "non-zero exit from container",
      "error_code": "SIF_EXEC_FAILED"
    }
  ],
  "fallback": [
    {
      "mode": "wrapper",
      "reason": "wrapper unavailable; fallback to sif"
    },
    {
      "mode": "spack",
      "reason": "sif unavailable; fallback to native/spack"
    }
  ],
  "metadata": {
    "invocation_precedence": [
      "wrapper",
      "sif",
      "spack"
    ],
    "bind_policy": {
      "inputs": [
        "/work/...",
        "/db/..."
      ],
      "outputs": "/out/...",
      "tmp": "/tmp/..."
    }
  }
}
