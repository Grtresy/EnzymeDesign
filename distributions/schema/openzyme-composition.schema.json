{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openzyme.local/schema/openzyme-composition@1.json",
  "title": "OpenZyme explicit distribution composition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "manifest_state",
    "distribution",
    "kernel",
    "adapters",
    "plugins",
    "drivers",
    "delivery_surfaces",
    "policy"
  ],
  "properties": {
    "schema_id": {"const": "openzyme_composition@1"},
    "manifest_state": {"enum": ["scaffold_not_activatable", "active"]},
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "distribution_name", "build_digest", "contract_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "distribution_name": {"type": "string", "minLength": 1},
        "build_digest": {"$ref": "#/$defs/digest"},
        "contract_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "contract_id",
        "contract_digest",
        "manifest_digest",
        "distribution_name",
        "distribution_version"
      ],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "contract_digest": {"$ref": "#/$defs/digest"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "distribution_name": {"type": "string", "minLength": 1},
        "distribution_version": {"type": "string", "minLength": 1}
      }
    },
    "adapters": {
      "type": "array",
      "items": {"$ref": "#/$defs/adapter"}
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": {"$ref": "#/$defs/component"}
        },
        "optional": {
          "type": "array",
          "items": {"$ref": "#/$defs/component"}
        }
      }
    },
    "drivers": {
      "type": "array",
      "items": {"$ref": "#/$defs/driver"}
    },
    "delivery_surfaces": {
      "type": "array",
      "items": {"$ref": "#/$defs/delivery"}
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambient_discovery_enables_components", "session_hot_swap"],
      "properties": {
        "ambient_discovery_enables_components": {"const": false},
        "session_hot_swap": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "distribution_name",
        "distribution_version",
        "manifest_digest"
      ],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "distribution_name": {"type": "string", "minLength": 1},
        "distribution_version": {"type": "string", "minLength": 1},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "component_id",
        "distribution_name",
        "distribution_version",
        "manifest_digest"
      ],
      "properties": {
        "slot": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "required": {"type": "boolean", "default": true},
        "component_id": {"type": "string", "minLength": 1},
        "distribution_name": {"type": "string", "minLength": 1},
        "distribution_version": {"type": "string", "minLength": 1},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "component_id",
        "owning_plugin_id",
        "distribution_name",
        "distribution_version",
        "manifest_digest"
      ],
      "properties": {
        "slot": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "owning_plugin_id": {"type": "string", "minLength": 1},
        "distribution_name": {"type": "string", "minLength": 1},
        "distribution_version": {"type": "string", "minLength": 1},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "contract_digest"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "contract_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
