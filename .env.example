# OpenZyme default runtime configuration.
# Copy to `.env` for local development and demo runs.

# LLM
OPENZYME_LLM_API_KEY=
OPENZYME_LLM_MODEL=glm-5.1
OPENZYME_LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
OPENZYME_LLM_TIMEOUT=60
OPENZYME_LLM_MAX_RETRIES=1
OPENZYME_LLM_TEMPERATURE=0

# Host API server bind
OPENZYME_HOST_API_HOST=127.0.0.1
OPENZYME_HOST_API_PORT=8000

# Host CLI / browser access URL
OPENZYME_HOST_BASE_URL=http://127.0.0.1:8000
OPENZYME_PROJECT_ID=
OPENZYME_EPISODE_ID=
OPENZYME_OUTPUT_FORMAT=text

# Research
OPENZYME_RESEARCH_MAX_UNITS=3
TAVILY_API_KEY=
OPENZYME_TAVILY_MAX_RESULTS=3
OPENZYME_TAVILY_TOPIC=general

# Tracing
OPENZYME_LANGSMITH_TRACING=false
OPENZYME_LANGSMITH_PROJECT=openzyme-v2

# Execution boundary selection
OPENZYME_EXECUTION_BACKEND=demo
OPENZYME_HPC_RUNNER_CONFIG=
