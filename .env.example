# OpenZyme default runtime configuration.
# Copy to `.env` for local development and local eval runs.

# LLM
OPENZYME_LLM_API_KEY=
OPENZYME_LLM_MODEL=gpt-5.4-mini
OPENZYME_LLM_BASE_URL=https://www.micuapi.ai/v1
OPENZYME_LLM_EXTRA_BODY=
OPENZYME_LLM_USE_RESPONSES_API=true
OPENZYME_LLM_USER_AGENT=codex_cli_rs/0.77.0 (Windows 10.0.26100; x86_64) WindowsTerminal
OPENZYME_LLM_MAX_TOKENS=
OPENZYME_LLM_TIMEOUT=60
OPENZYME_LLM_MAX_RETRIES=1
OPENZYME_LLM_TEMPERATURE=0
OPENZYME_LLM_STRUCTURED_OUTPUT_METHOD=function_calling
OPENZYME_LLM_STRUCTURED_OUTPUT_RETRY_BACKOFF_SECONDS=1

# Optional prompt-budget overrides. Leave blank to use built-in model profiles
# such as gpt-5.5: 1,050,000 context tokens, 128,000 max output tokens.
OPENZYME_LLM_CONTEXT_WINDOW_TOKENS=
OPENZYME_LLM_DEFAULT_OUTPUT_TOKENS=
OPENZYME_LLM_CONTEXT_WARN_RATIO=0.80
OPENZYME_LLM_CONTEXT_AUTO_COMPACT_RATIO=0.85
OPENZYME_LLM_CONTEXT_EMERGENCY_RATIO=0.90
OPENZYME_LLM_TOKENIZER_ENABLED=false

# Optional per-purpose LLM overrides
OPENZYME_LLM_REPORT_REVIEW_TIMEOUT=
OPENZYME_LLM_REPORT_REVIEW_MAX_TOKENS=
OPENZYME_LLM_REPORT_REVIEW_MAX_RETRIES=
OPENZYME_LLM_REPORT_REVIEW_STRUCTURED_OUTPUT_METHOD=
OPENZYME_LLM_REPORT_REVIEW_STRUCTURED_OUTPUT_RETRY_BACKOFF_SECONDS=
OPENZYME_LLM_V3_HARNESS_LOOP_TIMEOUT=
OPENZYME_LLM_V3_HARNESS_LOOP_MAX_TOKENS=
OPENZYME_LLM_V3_HARNESS_LOOP_MAX_RETRIES=
OPENZYME_LLM_V3_HARNESS_LOOP_STRUCTURED_OUTPUT_METHOD=
OPENZYME_LLM_V3_HARNESS_LOOP_STRUCTURED_OUTPUT_RETRY_BACKOFF_SECONDS=

# Host API server bind
OPENZYME_HOST_API_HOST=127.0.0.1
OPENZYME_HOST_API_PORT=8000
# local-dev 只能绑定 loopback；shared 必须同时配置 principals JSON。
OPENZYME_HOST_DEPLOYMENT_PROFILE=local-dev
# OPENZYME_HOST_AUTH_PRINCIPALS_JSON=[{"principal_id":"user:alice","token":"replace-with-at-least-32-random-characters","roles":["user"],"project_ids":["proj_001"]}]
# Debug 默认关闭；shared 启用后也只允许 operator/admin，且记录会脱敏。
OPENZYME_HOST_DEBUG_ENABLED=false

# Background agent runtime
OPENZYME_V3_BACKGROUND_RUNTIME_MAX_STEPS_PER_AGENT=12

# Host CLI / browser access URL
OPENZYME_HOST_BASE_URL=http://127.0.0.1:8000
# shared Host CLI bearer token；不要提交真实 token。
# OPENZYME_HOST_AUTH_TOKEN=
OPENZYME_PROJECT_ID=
OPENZYME_EPISODE_ID=
OPENZYME_OUTPUT_FORMAT=text

# Research
OPENZYME_RESEARCH_MAX_UNITS=3
# PubMed reuses the configured NCBI identity; API keys are optional secrets.
OPENZYME_NCBI_EMAIL=
OPENZYME_NCBI_TOOL=openzyme
OPENZYME_NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENZYME_RESEARCH_PROVIDER_TIMEOUT_SECONDS=30
OPENZYME_RESEARCH_PROVIDER_MAX_ATTEMPTS=3
TAVILY_API_KEY=
OPENZYME_TAVILY_MAX_RESULTS=3
OPENZYME_TAVILY_TOPIC=general

# Tracing
OPENZYME_LANGSMITH_TRACING=false
OPENZYME_LANGSMITH_PROJECT=openzyme-v2

# Execution boundary selection (`demo` keeps local deterministic adapters)
OPENZYME_EXECUTION_BACKEND=demo
OPENZYME_HPC_RUNNER_CONFIG=

# Opt-in live test toggles
OPENZYME_TEST_ENABLE_LIVE_LLM=false
OPENZYME_TEST_ENABLE_LIVE_TAVILY=false
OPENZYME_TEST_ENABLE_LIVE_HPC=false
OPENZYME_TEST_ENABLE_LIVE_E2E=false
OPENZYME_TEST_ENABLE_QUALITY_EVAL=false
OPENZYME_TEST_UPLOAD_LANGSMITH=false
OPENZYME_TEST_LIVE_LLM_TIMEOUT=120
OPENZYME_TEST_LIVE_LLM_MAX_TOKENS=500
OPENZYME_TEST_LIVE_LLM_MAX_RETRIES=0
OPENZYME_TEST_LIVE_LLM_STRUCTURED_OUTPUT_METHOD=function_calling
OPENZYME_TEST_LIVE_LLM_STRUCTURED_OUTPUT_RETRY_BACKOFF_SECONDS=0.5
# Persistent accounting for live/diagnostic MICU calls. The fixed 500M policy is not configurable; legacy 100M ledgers require the explicit operator migration documented in README.md.
OPENZYME_TEST_LIVE_LLM_TOKEN_LEDGER_PATH=.openzyme/live_micu_token_ledger.sqlite3
