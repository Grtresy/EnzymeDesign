{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool metadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object",
      "default": {},
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "tool_name",
    "generated_at",
    "inputs"
  ]
}
