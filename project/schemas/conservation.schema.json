{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MSA conservation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "method": {
      "type": "string"
    },
    "window_size": {
      "type": "integer",
      "minimum": 1
    },
    "residues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "residue": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          },
          "conservation_class": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        },
        "required": ["position", "residue", "score", "conservation_class"]
      }
    }
  },
  "required": ["schema_version", "method", "residues"]
}
