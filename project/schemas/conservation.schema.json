{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conservation",
  "type": "object",
  "required": ["schema_version", "msa", "per_residue"],
  "properties": {
    "schema_version": {"type": "string"},
    "msa": {
      "type": "object",
      "required": ["n_seq", "neff", "coverage"],
      "properties": {
        "n_seq": {"type": "integer"},
        "neff": {"type": "number"},
        "coverage": {"type": "number"}
      }
    },
    "per_residue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uid", "cons_score", "gap_fraction"],
        "properties": {
          "uid": {"type": "string"},
          "cons_score": {"type": "number"},
          "gap_fraction": {"type": "number"}
        }
      }
    }
  }
}
