{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tunnels",
  "type": "object",
  "required": ["schema_version", "tunnels"],
  "properties": {
    "schema_version": {"type": "string"},
    "tunnels": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": [
          "tunnel_id",
          "length",
          "bottleneck_radius",
          "throughput",
          "curvature",
          "lining_residues"
        ],
        "properties": {
          "tunnel_id": {"type": "string"},
          "length": {"type": "number"},
          "bottleneck_radius": {"type": "number"},
          "throughput": {"type": "number"},
          "curvature": {"type": "number"},
          "lining_residues": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
