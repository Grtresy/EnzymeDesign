{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tunnel detection",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "tunnels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tunnel_id": {
            "type": "string"
          },
          "length": {
            "type": "number",
            "minimum": 0
          },
          "bottleneck_radius": {
            "type": "number",
            "minimum": 0
          },
          "curvature": {
            "type": "number",
            "minimum": 0
          },
          "path": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                },
                "radius": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["x", "y", "z", "radius"]
            }
          }
        },
        "required": ["tunnel_id", "length", "bottleneck_radius", "curvature", "path"]
      }
    }
  },
  "required": ["schema_version", "tunnels"]
}
