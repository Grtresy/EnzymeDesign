{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docking",
  "type": "object",
  "required": ["schema_version", "method", "poses"],
  "properties": {
    "schema_version": {"type": "string"},
    "method": {"type": "string"},
    "best_affinity": {"type": ["number", "null"]},
    "top_confidence": {"type": ["number", "null"]},
    "poses": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["rank", "score", "path"],
        "properties": {
          "rank": {"type": "integer"},
          "score": {"type": "number"},
          "path": {"type": "string"}
        }
      }
    }
  }
}
