{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Score Breakdown",
  "type": "object",
  "required": [
    "schema_version",
    "variant_id",
    "checks",
    "subscores",
    "missing_penalties",
    "final_score",
    "needs_review",
    "top_reasons"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "variant_id": {"type": "string"},
    "checks": {"type": "object"},
    "subscores": {
      "type": "object",
      "properties": {
        "S_shrink": {"type": ["number", "null"]},
        "S_struct": {"type": ["number", "null"]},
        "S_mut_risk": {"type": ["number", "null"]},
        "S_cons": {"type": ["number", "null"]},
        "S_function_guard": {"type": ["number", "null"]}
      }
    },
    "missing_penalties": {"type": "object"},
    "final_score": {"type": "number"},
    "needs_review": {"type": "boolean"},
    "top_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
