{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Structure Confidence",
  "type": "object",
  "required": ["schema_version", "backend_id", "mean_plddt", "per_res_plddt", "clash_score"],
  "properties": {
    "schema_version": {"type": "string"},
    "backend_id": {"type": "string"},
    "mean_plddt": {"type": "number"},
    "per_res_plddt": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uid", "plddt"],
        "properties": {
          "uid": {"type": "string"},
          "plddt": {"type": "number"}
        }
      }
    },
    "clash_score": {"type": "number"}
  }
}
