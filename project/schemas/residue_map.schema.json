{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Residue Map",
  "type": "object",
  "required": ["schema_version", "residues", "index"],
  "properties": {
    "schema_version": {"type": "string"},
    "residues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uid",
          "chain",
          "auth_seq_id",
          "ins_code",
          "res_name",
          "seq_index_0based",
          "has_ca",
          "is_missing"
        ],
        "properties": {
          "uid": {"type": "string"},
          "chain": {"type": "string"},
          "auth_seq_id": {"type": "integer"},
          "ins_code": {"type": "string"},
          "res_name": {"type": "string"},
          "seq_index_0based": {"type": "integer"},
          "has_ca": {"type": "boolean"},
          "is_missing": {"type": "boolean"}
        }
      }
    },
    "index": {
      "type": "object",
      "required": ["by_seq_index", "by_auth"],
      "properties": {
        "by_seq_index": {"type": "object"},
        "by_auth": {"type": "object"}
      }
    }
  }
}
