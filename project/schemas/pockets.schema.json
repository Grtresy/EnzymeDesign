{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pockets",
  "type": "object",
  "required": ["schema_version", "pockets"],
  "properties": {
    "schema_version": {"type": "string"},
    "pockets": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["pocket_id", "score", "volume", "center", "residues"],
        "properties": {
          "pocket_id": {"type": "string"},
          "score": {"type": "number"},
          "volume": {"type": "number"},
          "center": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 3,
            "maxItems": 3
          },
          "residues": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
