{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Geometry Metrics",
  "type": "object",
  "required": [
    "schema_version",
    "seq_length",
    "wt_length",
    "delta_length",
    "rg",
    "wt_rg",
    "delta_rg",
    "sasa_total",
    "wt_sasa_total",
    "delta_sasa",
    "volume_protein",
    "wt_volume_protein",
    "delta_volume",
    "volume_method",
    "shrink_mode",
    "notes"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "seq_length": {"type": "integer"},
    "wt_length": {"type": "integer"},
    "delta_length": {"type": "integer"},
    "rg": {"type": "number"},
    "wt_rg": {"type": "number"},
    "delta_rg": {"type": "number"},
    "sasa_total": {"type": "number"},
    "wt_sasa_total": {"type": "number"},
    "delta_sasa": {"type": "number"},
    "volume_protein": {"type": "number"},
    "wt_volume_protein": {"type": "number"},
    "delta_volume": {"type": "number"},
    "volume_method": {"type": "string"},
    "shrink_mode": {"type": "string", "enum": ["length", "compact", "both"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
