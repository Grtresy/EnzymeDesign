rule score:
    input:
        structure=f"runs/{TARGET_ID}/{{variant_id}}/outputs/structure/folded_structure.pdb",
        residue_map=f"runs/{TARGET_ID}/{{variant_id}}/outputs/maps/residue_map.json",
        conservation=f"runs/{TARGET_ID}/{{variant_id}}/outputs/msa/conservation.json",
        volume=f"runs/{TARGET_ID}/{{variant_id}}/outputs/volume/volume_metrics.json",
        extras=optional_feature_inputs,
    output:
        f"runs/{TARGET_ID}/{{variant_id}}/outputs/scores/score_breakdown.json",
    params:
        input_args=lambda wildcards, input: format_inputs(input),
    shell:
        "python scripts/run_tool.py score {params.input_args} --output {output}"


rule leaderboard:
    input:
        expand(
            f"runs/{TARGET_ID}/{{variant_id}}/outputs/scores/score_breakdown.json",
            variant_id=VARIANTS,
        ),
    output:
        f"runs/{TARGET_ID}/batch/outputs/scores/leaderboard.csv",
    params:
        input_args=lambda wildcards, input: format_inputs(input),
    shell:
        "python scripts/run_tool.py leaderboard {params.input_args} --output {output}"
