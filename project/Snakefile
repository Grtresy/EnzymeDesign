rule docking:
    input:
        f"runs/{TARGET_ID}/{{variant_id}}/outputs/structure/folded_structure.pdb",
    output:
        f"runs/{TARGET_ID}/{{variant_id}}/outputs/docking/docking.json",
    shell:
