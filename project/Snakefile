import yaml
from pathlib import Path

configfile: "config/config.yaml"

TARGET_SPEC_PATH = "config/target_spec.yaml"

with open(TARGET_SPEC_PATH, "r", encoding="utf-8") as handle:
    TARGET_SPEC = yaml.safe_load(handle) or {}

TARGET_ID = TARGET_SPEC.get("target_id", config.get("target_id", "target"))
FEATURES = config.get("features", {})
ENABLE_POCKETS = FEATURES.get("pockets", False)
ENABLE_TUNNELS = FEATURES.get("tunnels", False)
ENABLE_DOCKING = FEATURES.get("docking", False)
PRIMARY_BACKEND = config.get("structure_primary_backend", "esmfold")
MODE = config.get("mode", "mock")


def read_variants(path: str):
    with open(path, newline="", encoding="utf-8") as handle:
        header = handle.readline().strip()
        if not header:
            return []
        delimiter = "," if "," in header else "\t" if "\t" in header else None
        columns = header.split(delimiter) if delimiter else header.split()
        variant_idx = columns.index("variant_id") if "variant_id" in columns else 0
        variants = []
        for row in handle:
            row = row.strip()
            if not row:
                continue
            parts = row.split(delimiter) if delimiter else row.split()
            variants.append(parts[variant_idx])
    return variants


VARIANTS = read_variants("inputs/variants.txt")


rule all:
    input:
        expand(
            f"runs/{TARGET_ID}/{{variant_id}}/outputs/scores/score_breakdown.json",
            variant_id=VARIANTS,
        ),
        f"runs/{TARGET_ID}/batch/outputs/scores/leaderboard.csv",
        "evidence/lit_hits.json",
        "constraints/key_residues_from_lit.yaml",
        "constraints/fixed_mask_regions.yaml",
        "constraints/pocket_key_residues.yaml",
        "constraints/tunnel_lining_residues.yaml",
        "constraints/tunnel_geometry.json",
        "prompts/prompt_pack.json",
        "prompts/esm3_request.yaml",
        "candidates/candidates.fasta",
        "candidates/metadata.json",
        "eval/fast_fold_scores.csv",
        "eval/af3_metrics.csv",
        "eval/docking_scores.csv",
        "eval/tunnel_check.csv",
        "rank/metrics_merged.csv",
        "rank/top_candidates.csv",
        "constraints/fixed_mask_regions_updated.yaml",
        "prompts/prompt_pack_updated.json",


rule init_variant_inputs:
    input:
        variant_list="inputs/variants.txt",
        target_fasta="inputs/target.fasta",
        reference_structure="inputs/reference_structure.pdb",
        key_residues="inputs/key_residues.json",
        hitl_decisions="inputs/hitl_decisions.csv",
    output:
        f"runs/{TARGET_ID}/{{variant_id}}/inputs/snapshot.json",
    conda:
        "envs/python.yml",
    params:
        mode=MODE,
    shell:
        (
            "python scripts/run_tool.py init_variant_inputs "
            "--input {input.variant_list} "
            "--input {input.target_fasta} "
            "--input {input.reference_structure} "
            "--input {input.key_residues} "
            "--input {input.hitl_decisions} "
            "--input inputs/variants/{{wildcards.variant_id}}.fasta "
            "--output {output} "
            "--mode {params.mode}"
        )


