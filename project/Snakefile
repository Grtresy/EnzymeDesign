rule score:
    input:
        structure_conf=f"runs/{TARGET_ID}/{{variant_id}}/outputs/structures/{PRIMARY_BACKEND}/structure_confidence.json",
        geometry=f"runs/{TARGET_ID}/{{variant_id}}/outputs/metrics/geometry_metrics.json",
        conservation=f"runs/{TARGET_ID}/{{variant_id}}/outputs/features/conservation.json",
        residue_map=f"runs/{TARGET_ID}/{{variant_id}}/outputs/residue_map.json",
        key_residues="inputs/key_residues.json",
        hitl_decisions="inputs/hitl_decisions.csv",
        pockets=lambda wildcards: (
            f"runs/{TARGET_ID}/{wildcards.variant_id}/outputs/pockets/fpocket/pockets.json"
            if ENABLE_POCKETS
            else []
        ),
        tunnels=lambda wildcards: (
            f"runs/{TARGET_ID}/{wildcards.variant_id}/outputs/tunnels/caver/tunnels.json"
            if ENABLE_TUNNELS
            else []
        ),
        docking=lambda wildcards: (
            f"runs/{TARGET_ID}/{wildcards.variant_id}/outputs/docking/docking.json"
            if ENABLE_DOCKING
            else []
        ),
    output:
        f"runs/{TARGET_ID}/{{variant_id}}/outputs/scores/score_breakdown.json",
    conda:
        "envs/python.yml",
    shell:
        (
            "python scripts/score_variants.py "
            "--structure-conf {input.structure_conf} "
            "--geometry {input.geometry} "
            "--conservation {input.conservation} "
            "--residue-map {input.residue_map} "
            "--key-residues {input.key_residues} "
            "--hitl-decisions {input.hitl_decisions} "
            "--pockets {input.pockets} "
            "--tunnels {input.tunnels} "
            "--docking {input.docking} "
            "--output {output}"
        )


rule leaderboard:
    input:
        expand(
            f"runs/{TARGET_ID}/{{variant_id}}/outputs/scores/score_breakdown.json",
            variant_id=VARIANTS,
        ),
    output:
        f"runs/{TARGET_ID}/batch/outputs/scores/leaderboard.csv",
    conda:
        "envs/python.yml",
    shell:
        "python scripts/build_leaderboard.py --inputs {input} --output {output}"


if ENABLE_POCKETS:
    rule all_pockets:
        input:
            expand(
                f"runs/{TARGET_ID}/{{variant_id}}/outputs/pockets/fpocket/pockets.json",
                variant_id=VARIANTS,
            )
